# ╔══════════════════════════════════════════════════════════╗
# ║  ArbCore — Local Environment Template                   ║
# ║  Copy to .env and fill in your values.                   ║
# ║  NEVER commit .env to version control.                   ║
# ╚══════════════════════════════════════════════════════════╝

# ── Runtime mode ──────────────────────────────────────────
ARBCORE_MODE=dry_run                   # dry_run | live
ARBCORE_EXCHANGES=binance,kraken       # comma-separated
ARBCORE_LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING | ERROR
ARBCORE_LOG_FORMAT=text                # text | json
ARBCORE_POLL_INTERVAL=2.0             # seconds between scan ticks
ARBCORE_STRATEGY=both                  # spatial | triangular | both
ARBCORE_USE_WEBSOCKET=false            # true = WS streams, false = REST polling
ARBCORE_CONCURRENT_EXEC=false          # true = fire legs simultaneously
ARBCORE_HEALTH_PORT=8080               # HTTP health-check port

# ── Risk limits ───────────────────────────────────────────
ARBCORE_MAX_TRADE_USD=100.0
ARBCORE_MAX_DRAWDOWN_PCT=2.0
ARBCORE_MAX_SLIPPAGE_PCT=0.15
ARBCORE_MAX_OPEN_EXPOSURE_USD=500.0
ARBCORE_DAILY_LOSS_LIMIT_USD=50.0

# ── Binance ───────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Kraken ────────────────────────────────────────────────
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── OKX (optional) ────────────────────────────────────────
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
