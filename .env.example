# ══════════════════════════════════════════════════════════════
# ArbCore — Environment Configuration
# ══════════════════════════════════════════════════════════════
# Copy to `.env` for local development.
# On Railway, set these as environment variables in the dashboard.
#
# SECURITY: Never commit a populated .env file to version control.

# ── Exchange API Credentials ─────────────────────────────────
# Leader exchange (primary price reference)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Tier-2 exchanges (stale-quote targets)
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

GATEIO_API_KEY=
GATEIO_API_SECRET=

MEXC_API_KEY=
MEXC_API_SECRET=

# Additional exchanges (optional)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ── Runtime Tunables ─────────────────────────────────────────
ARBCORE_MODE=dry_run                  # dry_run | live
ARBCORE_EXCHANGES=binance,kucoin      # comma-separated exchange ids
ARBCORE_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
ARBCORE_POLL_INTERVAL=1.0             # seconds between ticks
ARBCORE_STRATEGY=spatial              # spatial | triangular | both
ARBCORE_USE_WEBSOCKET=true            # true | false (WS = lower latency)
ARBCORE_CONCURRENT_EXEC=true          # true | false (fire legs simultaneously)
ARBCORE_HEALTH_PORT=8080              # HTTP health-check port

# ── Risk Limits ──────────────────────────────────────────────
ARBCORE_MAX_TRADE_USD=100.0           # per-trade notional cap
ARBCORE_MAX_DRAWDOWN_PCT=2.0          # session drawdown kill-switch %
ARBCORE_MAX_SLIPPAGE_PCT=0.15         # order-level slippage cap
ARBCORE_MAX_OPEN_EXPOSURE_USD=500.0   # aggregate open exposure cap
ARBCORE_DAILY_LOSS_LIMIT_USD=50.0     # hard daily stop-loss

# ── Phase 4: Circuit Breaker ────────────────────────────────
ARBCORE_MAX_API_FAILURES=3            # consecutive failures → trip
ARBCORE_MAX_ORDER_LATENCY_MS=5000     # per-leg latency ceiling
ARBCORE_MAX_WS_SILENCE_S=20.0        # WS heartbeat timeout (2× 10s)
ARBCORE_MAX_UNHEDGED_HOLD_S=30.0     # max time for unhedged position
ARBCORE_CB_COOLDOWN_S=60.0           # breaker cooldown before reset

# ── Phase 4: Oracle (Pyth Network) ──────────────────────────
ARBCORE_USE_ORACLE=false              # true | false
ARBCORE_ORACLE_MAX_CI_PCT=2.0        # reject trades during high CI
ARBCORE_ORACLE_REFRESH_S=2.0         # price refresh interval

# ── Phase 4: Feed Integrity ─────────────────────────────────
ARBCORE_FEED_RECONCILE_S=30.0        # REST vs WS reconcile interval
ARBCORE_FEED_DESYNC_PCT=0.5          # max mid-price divergence %
ARBCORE_FEE_REFRESH_S=300.0          # fee cache TTL (seconds)
